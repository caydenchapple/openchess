{
  "name": "openchess",
  "version": "0.1.0",
  "description": "Free, open-source, no-sign-up chess: play the computer or people online, then get an engine-backed review and coaching — all in your browser, no AI services.",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node scripts/build.js --watch & node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test test/*.test.js",
    "prestart": "node scripts/build.js"
  },
  "keywords": [
    "chess",
    "stockfish",
    "open-source",
    "coach"
  ],
  "author": "",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "dependencies": {
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "stockfish": "^19.0.1",
    "ws": "^8.22.2"
  },
  "private": false,
  "engines": {
    "node": ">=22.9"
  }
}
